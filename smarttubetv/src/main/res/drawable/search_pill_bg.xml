<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: YouTube TV style search pill background -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/tt_search_pill_focused" />
            <stroke android:width="2dp" android:color="@color/tt_search_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/tt_search_pill" />
        </shape>
    </item>
</selector>
