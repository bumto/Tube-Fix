<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: TizenTube style rail item (icon + label side by side) -->
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- MOD: group separator (visible on first item of each rail group) -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="56dp"
        android:layout_height="2dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="#4DFFFFFF"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:duplicateParentState="true"
        android:background="@drawable/header_pill_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <ImageView
            android:id="@+id/header_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:duplicateParentState="true"
            app:tint="@color/header_icon_tint"
            android:contentDescription="@string/header_icon" />

        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
            android:id="@+id/header_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="130dp"
            android:layout_marginStart="8dp"
            android:duplicateParentState="true"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"

            android:textColor="@color/header_label_color"
            android:textSize="13sp"
            style="@style/TextAppearance.Leanback.Header"/>

    </LinearLayout>

</androidx.leanback.widget.NonOverlappingLinearLayout>
