<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: TizenTube style rail item (icon + label side by side) -->
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="222dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- MOD: group separator (visible on first item of each rail group) -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3F3F3F"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:duplicateParentState="true"
        android:background="@drawable/header_pill_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/header_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:duplicateParentState="true"
            app:tint="@color/header_icon_tint"
            android:contentDescription="@string/header_icon" />

        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
            android:id="@+id/header_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="180dp"
            android:layout_marginStart="14dp"
            android:duplicateParentState="true"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"

            android:textColor="@color/header_label_color"
            android:textSize="12sp"/>

    </LinearLayout>

</androidx.leanback.widget.NonOverlappingLinearLayout>
