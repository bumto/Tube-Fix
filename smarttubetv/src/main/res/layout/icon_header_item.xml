<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: YouTube TV style rail item (icon + label stacked) -->
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="88dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/header_pill_bg">

    <ImageView
        android:id="@+id/header_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:tint="@color/header_icon_tint"
        android:contentDescription="@string/header_icon" />

    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
        android:id="@+id/header_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"

        android:gravity="center"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:ellipsize="marquee"
        android:scrollHorizontally="true"

        android:textColor="@color/header_label_color"
        android:textSize="13sp"
        style="@style/TextAppearance.Leanback.Header"/>

</androidx.leanback.widget.NonOverlappingLinearLayout>
