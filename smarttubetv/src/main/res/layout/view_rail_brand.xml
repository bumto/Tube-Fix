<?xml version="1.0" encoding="utf-8"?>
<!-- MOD: pinned rail brand header — SmartTube icon + name -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rail_brand"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingStart="0dp">

    <ImageView
        android:id="@+id/rail_brand_icon"
        android:layout_width="@dimen/rail_brand_icon_size"
        android:layout_height="@dimen/rail_brand_icon_size"
        android:src="@mipmap/app_icon"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/rail_brand_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rail_icon_margin"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/app_name"
        android:textColor="@color/card_default_text"
        android:textSize="@dimen/rail_brand_text_size"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
